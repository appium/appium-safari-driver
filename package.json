{
  "name": "appium-safari-driver",
  "version": "5.0.4",
  "description": "Appium driver for Safari browser",
  "keywords": [
    "appium",
    "safari",
    "safaridriver"
  ],
  "homepage": "https://appium.github.io/appium-safari-driver",
  "bugs": {
    "url": "https://github.com/appium/appium-safari-driver/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-safari-driver.git"
  },
  "bin": {},
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "build/lib",
    "LICENSE",
    "CHANGELOG.md",
    "npm-shrinkwrap.json"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run build -- --clean",
    "rebuild": "npm run clean; npm run build",
    "dev": "npm run build -- --watch",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "build:docs": "appium-docs build",
    "dev:docs": "appium-docs build --serve",
    "publish:docs": "appium-docs build --deploy --push -b docs-site -m 'docs: build docs for appium-safari-driver@%s' --alias latest --use-prefixed-major-deploy-version",
    "install-docs-deps": "appium-docs init --no-mkdocs",
    "prepare": "npm run build",
    "test": "node --enable-source-maps --test --test-timeout=60000 \"build/test/unit/**/*.test.js\"",
    "e2e-test": "npm run build && node --enable-source-maps --test --test-timeout=300000 \"build/test/functional/**/*.test.js\"",
    "e2e-test:desktop": "npm run build && node --enable-source-maps --test --test-timeout=300000 build/test/functional/desktop-driver-e2e.test.js",
    "e2e-test:simulator": "npm run build && node --enable-source-maps --test --test-timeout=300000 build/test/functional/mobile-driver-e2e.test.js"
  },
  "dependencies": {
    "asyncbox": "^6.1.0",
    "node-simctl": "^9.1.0",
    "portscanner": "2.2.0",
    "teen_process": "^4.0.4"
  },
  "devDependencies": {
    "@appium/docutils": "^2.5.0",
    "@appium/oxc-config": "^1.1.0",
    "@appium/semantic-release-config": "^1.1.0",
    "@appium/tsconfig": "^1.2.0",
    "@appium/types": "^1.0.0-rc.1",
    "@types/node": "^26.0.0",
    "@types/portscanner": "^2.1.4",
    "webdriverio": "^9.0.5"
  },
  "peerDependencies": {
    "appium": "^3.0.0-rc.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "appium": {
    "driverName": "safari",
    "automationName": "Safari",
    "platformNames": [
      "Mac",
      "iOS"
    ],
    "mainClass": "SafariDriver"
  }
}
